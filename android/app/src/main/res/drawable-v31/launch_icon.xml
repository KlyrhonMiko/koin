<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent padding keeps the OS splash icon as quiet as the Flutter logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="64dp" android:height="64dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/launch_logo" />
    </item>
</layer-list>
